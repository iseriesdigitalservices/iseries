# Copy this file to `.env` and fill in your own values.

# --- Database: MongoDB Atlas (cloud) ---
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/iseries?retryWrites=true&w=majority&appName=Cluster0
# (a local MongoDB also works for testing: mongodb://127.0.0.1:27017/iseries)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/iseries?retryWrites=true&w=majority&appName=Cluster0"
MONGODB_DB=iseries

# --- Admin panel password (change this before going live) ---
ADMIN_PASSWORD=1234

# --- Protects user sessions AND the encrypted password vault ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-this-to-a-long-random-text

# --- Optional ---
# SMTP_PASS=                 # Gmail App Password (or connect it in Admin > Notifications)
# SITE_URL=https://yourdomain.com
# COOKIE_SAMESITE=lax        # set this on your real live website

# Atlas must allow your server's IP:
#   cloud.mongodb.com > Network Access > Add IP Address > Allow access from anywhere (0.0.0.0/0)
